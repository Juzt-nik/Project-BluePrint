APP_NAME=SIH26265 FDR Management Portal
ENVIRONMENT=development

# Paste the SQLAlchemy/psycopg-compatible connection string from Supabase.
# Example shape only; replace every placeholder with your project values:
# DATABASE_URL=postgresql+psycopg://postgres.<PROJECT_REF>:<URL_ENCODED_PASSWORD>@<POOLER_HOST>:5432/postgres
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/sih26265
DATABASE_SSL_REQUIRED=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=30

# Configure these in the next step. Never put the service-role key in frontend code.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=fdr-documents-private
